DATABASE_URL="postgresql://user:password@localhost:5432/estatemgmt?schema=public"
# Only needed in production when DATABASE_URL points at a connection pooler
# (e.g. Supabase's transaction pooler on port 6543). Migrations need a
# direct, non-pooled connection — see docs/deployment.md. Leave unset for
# local development, where DATABASE_URL is already a direct connection.
# DIRECT_URL="postgresql://user:password@db.<project-ref>.supabase.co:5432/postgres"
SESSION_SECRET="generate-a-long-random-string-for-session-signing"

# Object storage for proof-of-payment uploads and the chairman signature.
# Optional for local development — omit all of these and files are written
# to local disk under .data/uploads/ instead. Required before deploying
# (see docs/deployment.md). Works unchanged with Cloudflare R2, Supabase
# Storage, or real AWS S3 — they all speak the same S3 API.
# S3_BUCKET="estatemgmt-uploads"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
